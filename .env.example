# Postgres. On Neon use the POOLED connection string (it contains "-pooler"),
# not the direct one — serverless functions open a connection per invocation
# and will exhaust a direct connection under any real traffic.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Secret used to sign the session cookie (HS256).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-32-plus-random-bytes"

# How long a report may sit in Submitted before it becomes a stale alert (goal 10).
STALE_AFTER_DAYS="5"
# How long a dismissal suppresses that alert before it returns.
ALERT_SNOOZE_DAYS="3"
